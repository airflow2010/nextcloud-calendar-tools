# ==== NEXTCLOUD CONNECTION ====
#
# Copy this file to .env and replace the placeholders with your own values.
# .env is intentionally ignored by Git because it contains credentials.

# Base CalDAV URL for the user's calendars.
# Example: https://cloud.example.com/remote.php/dav/calendars/<user>/
BASE_URL = "https://cloud.example.com/remote.php/dav/calendars/<user>/"

# Nextcloud login name and app password.
USER    = "<nextcloud-user>"
APP_PWD = "<nextcloud-app-password>"

# Calendar folder names used by the scripts.
CAL_NAME   = "privat"   # used by termin-coloring.py
CAL_WASTE  = "waste"    # used by waste-extraction.py / imports
CAL_HEURIG = "heurige"  # used by heurige-extraction.py
